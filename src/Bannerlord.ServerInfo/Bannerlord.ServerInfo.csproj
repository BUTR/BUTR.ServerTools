<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Bannerlord.ServerInfo</RootNamespace>
    <AssemblyName>Bannerlord.ServerInfo</AssemblyName>

    <ModuleId>Bannerlord.ServerInfo</ModuleId>
    <ModuleBinFolders>Win64_Shipping_Server;Linux64_Shipping_Server</ModuleBinFolders>
    <ImplementationProject>$(MSBuildThisFileDirectory)../Bannerlord.ServerInfo.Implementation/Bannerlord.ServerInfo.Implementation.csproj</ImplementationProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- v1.0.0 to v1.0.1: Pre-dates ModuleInfoModel; multiplayer module compatibility checked directly -->
    <Implementation Include="1.0.0" ReferenceVersion="1.0.0.4064" />
    <!-- v1.0.2 to v1.2.6: Introduces ModuleInfoModel.ShouldIncludeInSession -->
    <Implementation Include="1.0.2" ReferenceVersion="1.0.2.6960" />
    <!-- v1.2.7+: DedicatedServerConsoleCommandManager relocated to the Multiplayer module -->
    <Implementation Include="1.2.7" ReferenceVersion="1.2.7.31207" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Server.Core" Version="1.0.0.4064" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- Assemblies required by the loader: MBSubModuleBase, Debug, and ApplicationVersion -->
  <ItemGroup>
    <GameAssembly Include="TaleWorlds.Library;TaleWorlds.ModuleManager;TaleWorlds.MountAndBlade" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/**/*.cs" LinkBase="Shared" />
    <None Include="_Module/**/*" />
  </ItemGroup>

</Project>
